# Dosyaları yok sayma hakkında daha fazla bilgi için https://help.github.com/articles/ignoring-files/ adresini ziyaret edin.

# dependencies / bağımlılıklar
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing / Testler
/coverage

# next.js
/.next/
/out/

# production / Yayınlama
/build

# misc / diğerleri
.DS_Store
*.pem

# debug / hata ayıklama
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed) / env dosyaları (gerekirse commit işlemine dahil edilebilir)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
